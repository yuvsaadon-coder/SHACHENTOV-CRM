# פיתוח מקומי מול אמולטורי Firebase (ללא פרויקט אמיתי). הרצה: npm run dev:emulator
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-ashkolot.firebaseapp.com
