# העתיקו ל-.env.local ומלאו מתוך Firebase Console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# אופציונלי: App Check (reCAPTCHA Enterprise) - חוסם גישה ל-API שלא מהאפליקציה
VITE_RECAPTCHA_ENTERPRISE_KEY=
# אופציונלי: כניסה עם חשבון Microsoft (דורש הגדרת ספק Microsoft ב-Firebase Auth)
VITE_ENABLE_MICROSOFT=false
