{
  "name": "ashkolot-archive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "emulators": "cd .. && firebase emulators:start --only auth,firestore,storage --project demo-ashkolot",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:rules": "cd .. && firebase emulators:exec --only firestore,storage --project demo-ashkolot \"cd app && vitest run --config vitest.rules.config.ts\"",
    "skill": "node scripts/build-skill.ts",
    "setup": "node scripts/setup.ts",
    "import-archive": "node scripts/import-archive.ts"
  },
  "dependencies": {
    "@fontsource/alef": "^5.3.0",
    "fflate": "^0.8.3",
    "firebase": "^13.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
