rules_version = '2';

// ארכיון אשכולות העשור הבא - כללי אבטחה של Firestore
// עקרונות:
//  1. אין גישה בלי כניסה עם חשבון מאומת (Google או Microsoft) שמופיע ברשימת המשתמשים ופעיל.
//  2. שלושה תפקידים: viewer (צפייה), editor (העלאה, עריכה, תיוק מחדש), admin (משתמשים, טקסונומיה, מחיקה).
//  3. מסמך "לא להפצה" (restricted) גלוי רק ל-editor ו-admin.
//  4. כל ערך נבדק מול הטקסונומיה החיה (config/taxonomy). ערכים לא מוכרים נדחים בשרת.
//  5. כל יצירה/שינוי של מסמך חייבים לכתוב, באותה פעולה, רשומת היסטוריה עם מספר גרסה עוקב.
//     רשומות היסטוריה לא ניתנות לשינוי או למחיקה - יומן ביקורת שאי אפשר לזייף מהדפדפן.
//  6. ברירת מחדל: הכול חסום.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- זהות ותפקידים ----------
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'microsoft.com']
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider == 'microsoft.com');
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function userPath() { return /databases/$(database)/documents/users/$(myEmail()); }
    function me() { return get(userPath()).data; }
    function isActiveUser() { return signedIn() && exists(userPath()) && me().active == true; }
    function isEditor() { return isActiveUser() && me().role in ['editor', 'admin']; }
    function isAdmin() { return isActiveUser() && me().role == 'admin'; }

    function taxKeys() { return get(/databases/$(database)/documents/config/taxonomy).data.keys; }

    // ---------- טקסונומיה ----------
    match /config/taxonomy {
      allow read: if isActiveUser();
      allow create: if isAdmin() && validTaxonomy(request.resource.data);
      allow update: if isAdmin()
        && validTaxonomy(request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && noKeysRemoved(resource.data.keys, request.resource.data.keys);
      allow delete: if false;
    }

    function validTaxonomy(t) {
      return t.keys().hasOnly(['version', 'folders', 'dimensions', 'linkTypes', 'required', 'keys', 'updatedBy', 'updatedAt', '$comment'])
        && t.keys().hasAll(['version', 'folders', 'dimensions', 'linkTypes', 'keys', 'updatedBy', 'updatedAt'])
        && t.version is int
        && t.folders is list && t.linkTypes is list && t.dimensions is map && t.keys is map
        && t.keys.keys().hasAll(['folder', 'linkType', 'forum', 'dimension', 'responsibility', 'unit', 'leg', 'topic', 'stakeholderCircle', 'chapter', 'docType', 'status', 'publisher'])
        && t.updatedBy == myEmail()
        && t.updatedAt == request.time;
    }

    // ערכים אפשר רק להשבית, לא למחוק - כדי שמסמכים קיימים יישארו תקינים
    function noKeysRemoved(a, b) {
      return b.folder.hasAll(a.folder) && b.linkType.hasAll(a.linkType)
        && b.forum.hasAll(a.forum) && b.dimension.hasAll(a.dimension)
        && b.responsibility.hasAll(a.responsibility) && b.unit.hasAll(a.unit)
        && b.leg.hasAll(a.leg) && b.topic.hasAll(a.topic)
        && b.stakeholderCircle.hasAll(a.stakeholderCircle) && b.chapter.hasAll(a.chapter)
        && b.docType.hasAll(a.docType) && b.status.hasAll(a.status)
        && b.publisher.hasAll(a.publisher);
    }

    // ---------- משתמשים ----------
    match /users/{userEmail} {
      allow read: if isAdmin() || (signedIn() && myEmail() == userEmail);
      allow create, update: if isAdmin()
        && userEmail == userEmail.lower()
        && request.resource.data.keys().hasOnly(['role', 'active', 'name', 'updatedBy', 'updatedAt'])
        && request.resource.data.role in ['viewer', 'editor', 'admin']
        && request.resource.data.active is bool
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
        && request.resource.data.updatedBy == myEmail()
        && request.resource.data.updatedAt == request.time
        // מנהל/ת לא יכול/ה להוריד את ההרשאה של עצמו/ה (מונע נעילה של המערכת)
        && (userEmail != myEmail() || (request.resource.data.role == 'admin' && request.resource.data.active == true));
      allow delete: if isAdmin() && userEmail != myEmail();
    }

    // ---------- מסמכים ----------
    function validList(v, allowed) {
      return v is list && v.size() <= 24 && v.hasOnly(allowed);
    }

    function validFile(f, docId) {
      return f is map
        && f.keys().hasOnly(['path', 'name', 'size', 'contentType', 'sha256'])
        && f.keys().hasAll(['path', 'name', 'size', 'contentType', 'sha256'])
        && f.name is string && f.name.size() > 0 && f.name.size() <= 200
        && f.path == 'files/' + docId + '/' + f.name
        && f.size is int && f.size > 0 && f.size <= 104857600
        && f.contentType is string && f.contentType.size() <= 120
        && f.sha256 is string && f.sha256.matches('^[0-9a-f]{64}$');
    }

    function validDoc(d, docId) {
      let k = taxKeys();
      return d.keys().hasOnly([
          'title', 'folder', 'docType', 'status', 'publisher',
          'forum', 'dimension', 'responsibility', 'unit', 'leg', 'topic', 'stakeholderCircle', 'chapter',
          'meetingDate', 'year', 'summary', 'restricted', 'versionLabel', 'links', 'linkTargets',
          'familyId', 'isCurrent', 'archived', 'file', 'originalName',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'rev'])
        && d.keys().hasAll([
          'title', 'folder', 'docType', 'status', 'publisher',
          'forum', 'dimension', 'responsibility', 'unit', 'leg', 'topic', 'stakeholderCircle', 'chapter',
          'meetingDate', 'year', 'summary', 'restricted', 'versionLabel', 'links', 'linkTargets',
          'familyId', 'isCurrent', 'archived', 'file', 'originalName',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'rev'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && d.folder in k.folder
        && d.docType in k.docType
        && d.status in k.status
        && d.publisher in k.publisher
        && validList(d.forum, k.forum)
        && validList(d.dimension, k.dimension)
        && validList(d.responsibility, k.responsibility)
        && validList(d.unit, k.unit)
        && validList(d.leg, k.leg)
        && validList(d.topic, k.topic)
        && validList(d.stakeholderCircle, k.stakeholderCircle)
        && validList(d.chapter, k.chapter)
        && (d.meetingDate == null || (d.meetingDate is string && d.meetingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (d.folder != '09' || (d.meetingDate != null && d.forum.size() > 0))
        && (d.year == null || (d.year is int && d.year >= 1990 && d.year <= 2100))
        && d.summary is string && d.summary.size() <= 3000
        && d.restricted is bool && d.archived is bool && d.isCurrent is bool
        && d.versionLabel is string && d.versionLabel.size() <= 40
        && d.links is list && d.links.size() <= 50
        && d.linkTargets is list && d.linkTargets.size() <= 50
        && d.familyId is string && d.familyId.size() > 0 && d.familyId.size() <= 64
        && d.originalName is string && d.originalName.size() <= 300
        && (d.file == null || validFile(d.file, docId))
        && d.rev is int;
    }

    function historyWritten(docId, rev) {
      let hPath = /databases/$(database)/documents/documents/$(docId)/history/$(string(rev));
      return existsAfter(hPath)
        && getAfter(hPath).data.rev == rev
        && getAfter(hPath).data.by == myEmail();
    }

    match /documents/{docId} {
      // צופה רואה רק מסמכים שאינם מוגבלים. שאילתות של צופה חייבות לכלול where('restricted','==',false).
      allow read: if isActiveUser() && (isEditor() || resource.data.restricted == false);

      allow create: if isEditor()
        && validDoc(request.resource.data, docId)
        && request.resource.data.createdBy == myEmail()
        && request.resource.data.updatedBy == myEmail()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.rev == 1
        && request.resource.data.archived == false
        && (request.resource.data.familyId == docId
            || exists(/databases/$(database)/documents/documents/$(request.resource.data.familyId)))
        && historyWritten(docId, 1);

      allow update: if isEditor()
        && validDoc(request.resource.data, docId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.originalName == resource.data.originalName
        && (request.resource.data.file == resource.data.file || isAdmin())
        && request.resource.data.updatedBy == myEmail()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.rev == resource.data.rev + 1
        && historyWritten(docId, request.resource.data.rev);

      allow delete: if isAdmin();

      // ---------- יומן היסטוריה (append-only) ----------
      match /history/{rev} {
        allow read: if isActiveUser()
          && (isEditor() || get(/databases/$(database)/documents/documents/$(docId)).data.restricted == false);
        allow create: if isEditor()
          && request.resource.data.keys().hasOnly(['rev', 'by', 'at', 'action', 'changes'])
          && request.resource.data.keys().hasAll(['rev', 'by', 'at', 'action', 'changes'])
          && request.resource.data.rev is int
          && rev == string(request.resource.data.rev)
          && request.resource.data.by == myEmail()
          && request.resource.data.at == request.time
          && request.resource.data.action in ['create', 'update', 'archive', 'restore', 'new-version', 'superseded']
          && request.resource.data.changes is map
          && request.resource.data.changes.size() <= 40
          && getAfter(/databases/$(database)/documents/documents/$(docId)).data.rev == request.resource.data.rev;
        allow update, delete: if false;
      }
    }

    // תצוגת "פעילות אחרונה" למנהלים (שאילתת collectionGroup על כל ההיסטוריה)
    match /{path=**}/history/{rev} {
      allow read: if isAdmin();
    }

    // כל השאר חסום
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
