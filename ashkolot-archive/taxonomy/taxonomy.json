{
  "$comment": "מקור האמת היחיד למבנה התיוק. ממנו נגזרים: מסמך הייחוס של הסקיל, זריעת Firestore והאימות באפליקציה. מפתחות (key) לא משתנים לעולם - רק התוויות (label). ערך שמוציאים משימוש מסמנים active:false ולא מוחקים.",
  "version": 3,
  "folders": [
    {
      "key": "01",
      "label": "מסגרת ומתודולוגיה",
      "hint": "מדריכים, תבניות, מבנה המסמך הסופי, מילון מונחים, הנחיות לכותבים",
      "exclude": "תוכן מקצועי עצמו (ניתוח, סקירה) - לפי השלב בשרשרת; מצגת דוגמה שהיא גם תוצר - לפי התוכן"
    },
    {
      "key": "02-1",
      "label": "ספריית ידע / ממשלה ורגולציה",
      "hint": "משרד הפנים, מבקר המדינה, הכנסת, מנהל התכנון, הצעות חוק, נהלים",
      "exclude": "נתונים גולמיים של משרד הפנים (03); מסמך שהתוכנית כתבה על בסיס מקור ממשלתי (לפי שלב)"
    },
    {
      "key": "02-2",
      "label": "ספריית ידע / בינלאומי",
      "hint": "OECD, סקירות השוואתיות של מדינות",
      "exclude": "סקירה בינלאומית שכתב צוות של התוכנית (04)"
    },
    {
      "key": "02-3",
      "label": "ספריית ידע / מחקר וחשיבה",
      "hint": "ג'וינט-אלכא, סקירות ידע, מכוני מחקר, אקדמיה",
      "exclude": "מסמכי ג׳וינט-אלכא שנכתבו במסגרת התוכנית הנוכחית (לפי שלב)"
    },
    {
      "key": "02-4",
      "label": "ספריית ידע / מהשטח",
      "hint": "חומרים שהפיקו אשכולות ספציפיים: מצגות, מסמכי עמדה, קרנות",
      "exclude": "מצגת שאשכול הציג במפגש של התוכנית - אם היא חלק ממפגש (09) ומקושרת לכאן"
    },
    {
      "key": "03",
      "label": "נתונים",
      "hint": "רשימות רשויות, תקציבים, דשבורדים, כלי איסוף נתונים",
      "exclude": "דוח שמנתח נתונים (02 או 04); נתונים בתוך מצגת מפגש (09)"
    },
    {
      "key": "04",
      "label": "אבחון",
      "hint": "SWOT, ניתוח מצב קיים, יכולות דינמיות, סקירות של הצוותים",
      "exclude": "מקורות חיצוניים (02); שאיפות וכיוון (05); דילמות פתוחות (06)"
    },
    {
      "key": "05",
      "label": "כיוון",
      "hint": "SOAR, תמונת עתיד, שאיפות, עקרונות וערכים",
      "exclude": "מצב קיים (04); המלצה קונקרטית עם גורם מוסמך וכלי (07)"
    },
    {
      "key": "06",
      "label": "מתחים וסוגיות להכרעה",
      "hint": "מפות מתחים, מרשם שאלות פתוחות, הצלבות, שאלוני תיקוף",
      "exclude": "המלצה שכבר הוכרעה (07); מתח שמופיע כחלק מסיכום מפגש (09, עם קישור)"
    },
    {
      "key": "07",
      "label": "המלצות",
      "hint": "כרטיסי המלצה, חלופות",
      "exclude": "רעיונות ושאיפות בלי גורם מוסמך, כלי ולוח זמנים (05)"
    },
    {
      "key": "08",
      "label": "תוצר מדיניות",
      "hint": "טיוטות המסמך הסופי לוועדה ופרקיו",
      "exclude": "חומרי רקע לפרק (קישור \"מזין את\" מהמסמך המקורי)"
    },
    {
      "key": "09",
      "label": "מפגשים",
      "hint": "חומרי הכנה וסיכומים של כל הפורומים. כל מפגש מזוהה בשדה 'מפגש'",
      "exclude": "תוצר מקצועי מלא שרק הוצג במפגש - מתייקים לפי התוכן ומקשרים \"נדון במפגש\""
    }
  ],
