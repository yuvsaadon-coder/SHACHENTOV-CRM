rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // A signed-in user with no /users doc (or no role field) gets '' rather than
    // an evaluation error, so a half-provisioned account is denied instead of
    // failing the whole request with "Missing or insufficient permissions".
    // A deactivated person gets '' too: removing someone removes their access.
    function role() {
      return isAuthed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().get('active', true) != false
        ? me().get('role', '')
        : '';
    }

    function isAdmin()       { return role() == 'admin'; }
    function isCoordinator() { return role() == 'coordinator'; }

    // System managers: may grant HQ access and read the passwords they set.
    // 'CEO' is a legacy value still stored on older accounts.
    function isManager()     { return role() in ['admin', 'CEO']; }

    // The app routes on "coordinator or not": App.tsx sends coordinators to the
    // portal and every other signed-in user to the CRM. Staff roles are stored
    // as 'hq' or, on older accounts, as domain codes (JLM, SUP, DON, FIN, PUB,
    // DES, VOL), so match the app instead of an allow-list. 'none' is a person
    // who is in the directory but has no system access.
    function isHQ() {
      return isAuthed() && !(role() in ['', 'coordinator', 'none']);
    }

    // True when the branch is one of the signed-in person's portal branches.
    // branchIds is derived from the positions the person holds and is written
    // only by HQ, together with those positions.
    function coordinatesBranch(branchId) {
      return role() != '' && branchId in me().get('branchIds', []);
    }

    function hasNoStaffAccess(data) {
      return data.get('role', 'none') in ['coordinator', 'none'];
    }

    function isQuarter(quarter) {
      return quarter in ['Q1', 'Q2', 'Q3', 'Q4'];
    }

    function isCanonicalReport(id, data) {
      return data.branchId is string
        && data.year is int
        && isQuarter(data.quarter)
        && id == data.branchId + '_' + string(data.year) + '_' + data.quarter;
    }

    function reportIdentityUnchanged() {
      return request.resource.data.branchId == resource.data.branchId
        && request.resource.data.year == resource.data.year
        && request.resource.data.quarter == resource.data.quarter
        && request.resource.data.submittedBy == resource.data.submittedBy;
    }

    // ── CRM (HQ staff & admins) ──────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read, write: if isHQ();
      match /{sub}/{subId} {
        allow read, write: if isHQ();
      }
    }

    match /contacts/{id} { allow read, write: if isHQ(); }
    match /roles/{id}    { allow read, write: if isHQ(); }

    // Coordinators need to read their own branch document to enter the portal.
    match /branches/{id} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── Knowledge ────────────────────────────────────────────────────────────
    match /hq_knowledge/{id}       { allow read: if isHQ();    allow write: if isAdmin(); }
    match /knowledge_articles/{id} { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /knowledgeItems/{id} {
      allow read:  if isAuthed();
      allow write: if isCoordinator() || isHQ();
    }

    // ── Quarterly reports ────────────────────────────────────────────────────
    // HQ sees everything (the /reports page). A coordinator reads the reports of
    // branches they are attached to — without this, "הדיווחים שלי" in the portal
    // is denied.
    match /quarterlyReports/{id} {
      // A transaction must be able to read the canonical path before its first
      // create. A missing document contains no data; existing reports remain
      // restricted to HQ or coordinators of that branch.
      allow read: if isHQ()
                  || (isCoordinator() && resource == null)
                  || coordinatesBranch(resource.data.branchId);
      allow create: if isCoordinator()
                    && isCanonicalReport(id, request.resource.data)
                    && request.resource.data.submittedBy == request.auth.uid
                    && coordinatesBranch(request.resource.data.branchId);
      // Historical random-ID records remain editable, but identity fields are
      // immutable. Canonical records must also continue matching their ID.
      allow update: if isAdmin()
                    && reportIdentityUnchanged()
                    && (!isCanonicalReport(id, resource.data)
                        || isCanonicalReport(id, request.resource.data));
      allow delete: if isAdmin();
    }

    // Coordinators read this to render the report form; only admins edit it.
    match /reportQuestions/{id} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── People ───────────────────────────────────────────────────────────────
    // `users` is the people directory: every person, the positions they hold
    // (roleIds) and their access level (role). HQ staff keep it up to date —
    // that is how a coordinator is replaced — but only a manager may give or
    // change HQ / admin access, so nobody can promote themselves.
    match /users/{uid} {
      allow read: if isAuthed() && (request.auth.uid == uid || isHQ());

      allow create: if isManager()
                    || (isHQ() && hasNoStaffAccess(request.resource.data));

      allow update: if isManager()
                    || (isHQ() && hasNoStaffAccess(resource.data) && hasNoStaffAccess(request.resource.data))
                    // HQ staff may move another staff member between positions, but
                    // not touch what their login hangs on: access, e-mail, phone.
                    || (isHQ()
                        && request.resource.data.get('role', '') == resource.data.get('role', '')
                        && request.resource.data.get('active', true) == resource.data.get('active', true)
                        && request.resource.data.get('email', '') == resource.data.get('email', '')
                        && request.resource.data.get('phone', '') == resource.data.get('phone', ''))
                    || (request.auth.uid == uid && role() != ''
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'updatedAt']));

      allow delete: if isManager();

      // Chat history is private to its owner.
      match /chatSessions/{sessionId} {
        allow read, write: if isAuthed() && request.auth.uid == uid;
      }

      // Personal to-dos — private to their owner, not part of the org tasks.
      match /personalTasks/{taskId} {
        allow read, write: if isAuthed() && request.auth.uid == uid;
      }
    }

    // HQ login passwords set by management (the phone number by default).
    // Written only by the server; the owner may delete theirs after choosing a
    // password of their own, so a stale one is never shown.
    match /userSecrets/{uid} {
      allow read:   if isManager();
      allow delete: if isManager() || (isAuthed() && request.auth.uid == uid);
      allow create, update: if false;
    }
  }
}
