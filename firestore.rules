rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // A signed-in user with no /users doc (or no role field) gets '' rather than
    // an evaluation error, so a half-provisioned account is denied instead of
    // failing the whole request with "Missing or insufficient permissions".
    // A deactivated person gets '' too: removing someone removes their access.
    function role() {
      return isAuthed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().get('active', true) != false
        ? me().get('role', '')
        : '';
    }

    function isAdmin()       { return role() == 'admin'; }
    function isCoordinator() { return role() == 'coordinator'; }

    // System managers: may grant HQ access and read the passwords they set.
    // 'CEO' is a legacy value still stored on older accounts.
    function isManager()     { return role() in ['admin', 'CEO']; }

    // The app routes on "coordinator or not": App.tsx sends coordinators to the
    // portal and every other signed-in user to the CRM. Staff roles are stored
    // as 'hq' or, on older accounts, as domain codes (JLM, SUP, DON, FIN, PUB,
    // DES, VOL), so match the app instead of an allow-list. 'none' is a person
    // who is in the directory but has no system access.
    function isHQ() {
      return isAuthed() && !(role() in ['', 'coordinator', 'none']);
    }

    // True when the branch is one of the signed-in person's portal branches.
    // branchIds is derived from the positions the person holds and is written
    // only by HQ, together with those positions.
    function coordinatesBranch(branchId) {
      return role() != '' && branchId in me().get('branchIds', []);
    }

    function hasNoStaffAccess(data) {
      return data.get('role', 'none') in ['coordinator', 'none'];
    }

    // ── CRM (HQ staff & admins) ──────────────────────────────────────────────
    // Deleting shared records is reserved for system managers; HQ staff may
    // still create and edit them.
    match /tasks/{taskId} {
      allow read, create, update: if isHQ();
      allow delete: if isManager();
      match /{sub}/{subId} {
        allow read, write: if isHQ();
      }
    }

    match /contacts/{id} { allow read, create, update: if isHQ(); allow delete: if isManager(); }
    match /roles/{id}    { allow read, create, update: if isHQ(); allow delete: if isManager(); }

    // Coordinators need to read their own branch document to enter the portal.
    match /branches/{id} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── Knowledge ────────────────────────────────────────────────────────────
    match /hq_knowledge/{id}       { allow read: if isHQ();    allow write: if isAdmin(); }
    match /knowledge_articles/{id} { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /knowledgeItems/{id} {
      allow read:  if isAuthed();
      allow write: if isCoordinator() || isHQ();
    }

    // ── HQ Knowledge Base (new collections) ─────────────────────────────────
    match /hq_finance/{id} { allow read, create, update: if isHQ(); allow delete: if isManager(); }
    match /hq_official_docs/{id} { allow read, create, update: if isHQ(); allow delete: if isManager(); }
    match /hq_drive_links/{id} { allow read, create, update: if isHQ(); allow delete: if isManager(); }
    match /hq_partners/{id} { allow read, create, update: if isHQ(); allow delete: if isManager(); }
    match /hq_suppliers/{id} { allow read, create, update: if isHQ(); allow delete: if isManager(); }

    // ── Quarterly reports ────────────────────────────────────────────────────
    // HQ sees everything (the /reports page). A coordinator reads the reports of
    // branches they are attached to — without this, "הדיווחים שלי" in the portal
    // is denied.
    match /quarterlyReports/{id} {
      allow read: if isHQ() || coordinatesBranch(resource.data.branchId);
      allow create: if isCoordinator()
                    && request.resource.data.submittedBy == request.auth.uid
                    && coordinatesBranch(request.resource.data.branchId);
      allow update, delete: if isAdmin();
    }

    // Coordinators read this to render the report form; only admins edit it.
    match /reportQuestions/{id} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── People ───────────────────────────────────────────────────────────────
    // `users` is the people directory: every person, the positions they hold
    // (roleIds) and their access level (role). HQ staff keep it up to date —
    // that is how a coordinator is replaced — but only a manager may give or
    // change HQ / admin access, so nobody can promote themselves.
    match /users/{uid} {
      allow read: if isAuthed() && (request.auth.uid == uid || isHQ());

      allow create: if isManager()
                    || (isHQ() && hasNoStaffAccess(request.resource.data));

      allow update: if isManager()
                    || (isHQ() && hasNoStaffAccess(resource.data) && hasNoStaffAccess(request.resource.data))
                    // HQ staff may move another staff member between positions, but
                    // not touch what their login hangs on: access, e-mail, phone.
                    || (isHQ()
                        && request.resource.data.get('role', '') == resource.data.get('role', '')
                        && request.resource.data.get('active', true) == resource.data.get('active', true)
                        && request.resource.data.get('email', '') == resource.data.get('email', '')
                        && request.resource.data.get('phone', '') == resource.data.get('phone', ''))
                    || (request.auth.uid == uid && role() != ''
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'updatedAt']));

      allow delete: if isManager();

      // Chat history is private to its owner.
      match /chatSessions/{sessionId} {
        allow read, write: if isAuthed() && request.auth.uid == uid;
      }

      // Personal to-dos — private to their owner, not part of the org tasks.
      match /personalTasks/{taskId} {
        allow read, write: if isAuthed() && request.auth.uid == uid;
      }
    }

    // HQ login passwords set by management (the phone number by default).
    // Written only by the server; the owner may delete theirs after choosing a
    // password of their own, so a stale one is never shown.
    match /userSecrets/{uid} {
      allow read:   if isManager() || (isAuthed() && request.auth.uid == uid);
      allow delete: if isManager() || (isAuthed() && request.auth.uid == uid);
      allow create, update: if false;
    }

    // ── Volunteer scheduling ─────────────────────────────────────────────────

    // Volunteer records — HQ reads all; coordinator reads/writes for their branches.
    // No auth check on the volunteer doc itself because public volunteer page
    // goes through the Netlify Function (server-side Admin SDK), not the client SDK.
    match /volunteers/{id} {
      allow read:   if isHQ() || (isCoordinator() && resource.data.branchIds.hasAny(me().get('branchIds', [])));
      allow create: if isHQ() || isCoordinator();
      allow update: if isHQ()
                    || (isCoordinator() && resource.data.branchIds.hasAny(me().get('branchIds', [])));
      allow delete: if isHQ() || isAdmin();
    }

    // Token lookup docs — read/write only by coordinators managing that branch,
    // and by HQ. The public page uses the Admin SDK so it bypasses these rules.
    match /volunteer_tokens/{token} {
      allow read:   if isHQ() || isCoordinator();
      allow write:  if isHQ() || isCoordinator();
    }

    // Shifts — coordinators manage their own branches; HQ reads all.
    match /shifts/{id} {
      allow read:   if isHQ() || (isCoordinator() && coordinatesBranch(resource.data.branchId));
      allow create: if isCoordinator() && coordinatesBranch(request.resource.data.branchId);
      allow update: if isHQ()
                    || (isCoordinator() && coordinatesBranch(resource.data.branchId));
      allow delete: if isHQ()
                    || (isCoordinator() && coordinatesBranch(resource.data.branchId));
    }

    // Assignments — coordinators manage their own branches; HQ reads all.
    // Volunteer self-service goes through the Netlify Function (Admin SDK).
    match /assignments/{id} {
      allow read:   if isHQ() || (isCoordinator() && coordinatesBranch(resource.data.branchId));
      allow create: if isCoordinator() && coordinatesBranch(request.resource.data.branchId);
      allow update: if isHQ()
                    || (isCoordinator() && coordinatesBranch(resource.data.branchId));
      allow delete: if isAdmin();
    }

    // Monthly responses — same access as assignments.
    match /monthly_responses/{id} {
      allow read:   if isHQ() || (isCoordinator() && coordinatesBranch(resource.data.branchId));
      allow write:  if isHQ()
                    || (isCoordinator() && coordinatesBranch(request.resource.data.branchId));
    }
      // ── Basket survey (voting module, collections voting_*) ─────────────────
    // Managing the survey is HQ staff; the CRM screens further limit it to system admins and the
    // Jerusalem-branches domain. A coordinator reads the round and the catalog, and writes only their OWN vote,
    // for one of their own branches, while the round is open. Votes are never deleted except when HQ archives them.
    function votingRoundOpen() {
      return !exists(/databases/$(database)/documents/voting_config/main)
        || get(/databases/$(database)/documents/voting_config/main).data.get('round', {}).get('open', true) == true;
    }

    match /voting_config/{id}   { allow read: if isAuthed(); allow write: if isHQ(); }
    match /voting_branches/{id} { allow read: if isAuthed(); allow write: if isHQ(); }

    // Document id = {uid}_{branchId}
    match /voting_votes/{voteId} {
      allow read: if isHQ() || (isAuthed() && voteId.matches('^' + request.auth.uid + '_.+$'));
      allow create, update: if isCoordinator()
        && request.resource.data.uid == request.auth.uid
        && voteId == request.auth.uid + '_' + request.resource.data.branchId
        && coordinatesBranch(request.resource.data.branchId)
        && request.resource.data.keys().hasOnly(['uid', 'branchId', 'name', 'submittedAt', 'baskets', 'round', 'serverSubmittedAt'])
        && request.resource.data.baskets is map
        && votingRoundOpen();
      allow delete: if isHQ();
    }

    match /voting_archivedVotes/{id}  { allow read, create: if isHQ(); allow update, delete: if false; }
    match /voting_priceQuotes/{id}    { allow read, create, update: if isHQ(); allow delete: if isManager(); }
    match /voting_priceDecisions/{id} { allow read, create, update: if isHQ(); allow delete: if isManager(); }
    match /voting_rounds/{id}         { allow read, create, update: if isHQ(); allow delete: if isManager(); }
  }
}
