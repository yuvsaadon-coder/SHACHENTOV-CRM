rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: signed-in user with an active /users doc and a non-coordinator role
    function isHQ() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('active', true) != false
        && !(firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') in ['', 'coordinator', 'none']);
    }

    // Finance documents: any HQ member may read/write
    match /hq_finance/{uid}/{fileName} {
      allow read:  if isHQ();
      allow write: if isHQ() && request.auth.uid == uid;
    }

    // Official documents: any HQ member may read/write
    match /hq_official_docs/{uid}/{fileName} {
      allow read:  if isHQ();
      allow write: if isHQ() && request.auth.uid == uid;
    }

    // Research articles uploaded from the knowledge admin screen: HQ only
    match /knowledge_articles/{docId}/{fileName} {
      allow read, write: if isHQ();
    }
  }
}
