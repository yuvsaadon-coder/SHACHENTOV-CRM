rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /hq_knowledge/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /knowledge_articles/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
