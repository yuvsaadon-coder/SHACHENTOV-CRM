rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /hq_knowledge/{allPaths=**} {
      allow read: if request.auth != null;
      // The client only stages a file; the trusted Netlify operation owns the
      // corresponding Firestore record, mirror, replacement, and deletion.
      allow write: if isAdmin();
    }
    match /knowledge_articles/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
