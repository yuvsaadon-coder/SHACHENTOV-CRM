rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthed() {
      return request.auth != null;
    }

    function isHQ() {
      return isAuthed();
    }

    // Task attachments — authenticated users only, max 20 MB
    match /tasks/{taskId}/{fileName} {
      allow read: if isHQ();
      allow write: if isHQ()
        && request.resource.size < 20 * 1024 * 1024;
      allow delete: if isHQ();
    }

    // Knowledge article PDFs — authenticated write, authenticated read
    match /knowledge/{fileName} {
      allow read: if isAuthed();
      allow write: if isAuthed()
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/msword')
          || request.resource.contentType.matches('application/vnd.openxmlformats.*')
        );
      allow delete: if isAuthed();
    }

    // Coordinator handover docs & formats — PDF, Word, Excel, max 50 MB
    match /handover/{branchId}/{fileName} {
      allow read: if isAuthed();
      allow write: if isAuthed()
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/msword')
          || request.resource.contentType.matches('application/vnd.openxmlformats.*')
          || request.resource.contentType.matches('application/vnd.ms-excel')
          || request.resource.contentType.matches('text/csv')
        );
      allow delete: if isAuthed();
    }

    // Catch-all: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
