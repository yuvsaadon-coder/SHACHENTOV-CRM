# Firebase web config: public by design (security comes from firestore.rules, not from hiding these).
# Set the same names in Netlify: Site settings -> Environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# 'true' to talk to local emulators (npm run emulators)
VITE_FIREBASE_EMULATORS=false
