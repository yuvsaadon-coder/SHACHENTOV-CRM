{
  "name": "shachentov-voting",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src tests",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:reference": "node --test reference/algorithm.test.mjs",
    "test:rules": "echo 'Rules tests arrive in Phase 1 (SPEC §9.5)' && exit 0",
    "test:e2e": "playwright test --trace off",
    "emulators": "firebase emulators:start --only auth,firestore"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
